  "firestore": {
    "/trips/{tripId}": {
      "schema": { "$ref": "#/entities/FeederTrip" },
      "description": "Koleksi data gangguan dan trip penyulang"
    },
    "/feeder_health/{healthId}": {
      "schema": { "$ref": "#/entities/FeederHealth" },
      "description": "Koleksi indeks kesehatan penyulang"
    },
    "/saidi_saifi/{saidiId}": {
      "schema": { "$ref": "#/entities/MonthlySaidiSaifiData" },
      "description": "Koleksi pencapaian SAIDI SAIFI bulanan"
    },
    "/spk_tasks/{spkId}": {
      "schema": { "$ref": "#/entities/SpkTask" },
      "description": "Koleksi SPK tugas petugas"
    },
    "/gardu_measurements/{garduId}": {
      "schema": { "$ref": "#/entities/GarduMeasurement" },
      "description": "Koleksi pengukuran beban gardu"
    },
    "/master_feeders/{feederId}": {
      "schema": { "$ref": "#/entities/MasterFeeder" },
      "description": "Master data penyulang"
    },
    "/master_sections/{sectionId}": {
      "schema": { "$ref": "#/entities/MasterSection" },
      "description": "Master data seksi jaringan / sections"
    },
    "/master_gardu_hubung/{ghId}": {
      "schema": { "$ref": "#/entities/MasterGarduHubung" },
      "description": "Master data gardu hubung"
    },
    "/master_gardu_distribusi/{gdId}": {
      "schema": { "$ref": "#/entities/MasterGarduDistribusi" },
      "description": "Master data gardu distribusi"
    },
    "/master_pemutus/{pmtId}": {
      "schema": { "$ref": "#/entities/MasterPemutus" },
      "description": "Master data peralatan pemutus beban"
    },
    "/materials/{materialId}": {
      "schema": { "$ref": "#/entities/MaterialItem" },
      "description": "Koleksi stok material K3 dan SUTM"
    },
    "/apd_tools/{apdId}": {
      "schema": { "$ref": "#/entities/ApdTool" },
      "description": "Koleksi peralatan APD dan K3"
    },
    "/vehicles/{vehicleId}": {
      "schema": { "$ref": "#/entities/Vehicle" },
      "description": "Koleksi armada kendaraan Yantek"
    },
    "/users_access/{userId}": {
      "schema": { "$ref": "#/entities/UserAccess" },
      "description": "Koleksi pengguna dan hak akses"
    }
  }
}
