{
  "entities": {
    "FeederTrip": {
      "title": "FeederTrip",
      "description": "Log data trip/gangguan penyulang PLN ULP Baguala",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "feederName": { "type": "string" },
        "substation": { "type": "string" },
        "tripDate": { "type": "string" },
        "tripTime": { "type": "string" },
        "recoveryTime": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "relayType": { "type": "string" },
        "currentAmpere": { "type": "number" },
        "kwPadam": { "type": "number" },
        "locationKm": { "type": "string" },
        "cause": { "type": "string" },
        "category": { "type": "string" },
        "affectedCustomers": { "type": "number" },
        "totalUlpCustomers": { "type": "number" },
        "saidiHours": { "type": "number" },
        "saidiMinutes": { "type": "number" },
        "saifiCount": { "type": "number" },
        "ensKwh": { "type": "number" },
        "financialLossIdr": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "feederName", "tripDate", "tripTime", "durationMinutes", "status"]
    },
    "FeederHealth": {
      "title": "FeederHealth",
      "description": "Indeks kesehatan penyulang",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "substation": { "type": "string" },
        "lengthKm": { "type": "number" },
        "customers": { "type": "number" },
        "healthScore": { "type": "number" },
        "status": { "type": "string" },
        "lastInspected": { "type": "string" },
        "rowRiskPoints": { "type": "number" },
        "thermoHotspots": { "type": "number" },
        "groundingResistance": { "type": "number" }
      },
      "required": ["id", "name", "healthScore"]
    },
    "MonthlySaidiSaifiData": {
      "title": "MonthlySaidiSaifiData",
      "description": "Realisasi dan Target SAIDI/SAIFI bulanan",
      "type": "object",
      "properties": {
        "year": { "type": "number" },
        "month": { "type": "string" },
        "saidiReal": { "type": "number" },
        "saidiTarget": { "type": "number" },
        "saifiReal": { "type": "number" },
        "saifiTarget": { "type": "number" },
        "ensLossJuta": { "type": "number" }
      },
      "required": ["month", "saidiReal", "saidiTarget", "saifiReal", "saifiTarget"]
    },
    "SpkTask": {
      "title": "SpkTask",
      "description": "Surat Perintah Kerja (SPK) petugas Yantek",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "spkNumber": { "type": "string" },
        "date": { "type": "string" },
        "taskType": { "type": "string" },
        "feederName": { "type": "string" },
        "locationSection": { "type": "string" },
        "teamName": { "type": "string" },
        "targetQty": { "type": "string" },
        "status": { "type": "string" },
        "priority": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "spkNumber", "taskType", "feederName", "status"]
    },
    "GarduMeasurement": {
      "title": "GarduMeasurement",
      "description": "Pengukuran beban gardu distribusi",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "garduCode": { "type": "string" },
        "garduName": { "type": "string" },
        "feederName": { "type": "string" },
        "capacityKva": { "type": "number" },
        "date": { "type": "string" },
        "inspectorName": { "type": "string" },
        "currentR": { "type": "number" },
        "currentS": { "type": "number" },
        "currentT": { "type": "number" },
        "currentN": { "type": "number" },
        "voltageRN": { "type": "number" },
        "voltageSN": { "type": "number" },
        "voltageTN": { "type": "number" },
        "loadPercentage": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "garduCode", "capacityKva", "loadPercentage", "status"]
    },
    "MasterFeeder": {
      "title": "MasterFeeder",
      "description": "Master data penyulang ULP Baguala",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "feederCode": { "type": "string" },
        "feederName": { "type": "string" },
        "substationName": { "type": "string" },
        "voltageKv": { "type": "number" },
        "lengthKms": { "type": "number" },
        "customerCount": { "type": "number" },
        "sectionCount": { "type": "number" },
        "breakerType": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "feederCode", "feederName", "status"]
    },
    "MasterSection": {
      "title": "MasterSection",
      "description": "Master data seksi / section penyulang ULP Baguala",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sectionCode": { "type": "string" },
        "sectionName": { "type": "string" },
        "feederName": { "type": "string" },
        "substationOrGh": { "type": "string" },
        "startPoint": { "type": "string" },
        "endPoint": { "type": "string" },
        "garduCount": { "type": "number" },
        "lengthKms": { "type": "number" },
        "khaAmpere": { "type": "number" },
        "status": { "type": "string" },
        "hasFcoBranch": { "type": "boolean" },
        "fcoBranchName": { "type": "string" },
        "fcoLengthKms": { "type": "number" },
        "fcoKhaAmpere": { "type": "number" },
        "currentLoadAmpere": { "type": "number" },
        "voltageDropPercent": { "type": "number" },
        "temperatureCelsius": { "type": "number" }
      },
      "required": ["id", "sectionCode", "sectionName", "feederName", "status"]
    },
    "MasterGarduHubung": {
      "title": "MasterGarduHubung",
      "description": "Master data gardu hubung (GH)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ghCode": { "type": "string" },
        "ghName": { "type": "string" },
        "location": { "type": "string" },
        "incomingFeeder": { "type": "string" },
        "outgoingFeedersCount": { "type": "number" },
        "outgoingFeedersList": { "type": "string" },
        "ghType": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "ghCode", "ghName", "incomingFeeder", "status"]
    },
    "MasterGarduDistribusi": {
      "title": "MasterGarduDistribusi",
      "description": "Master data gardu distribusi (GD)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "garduCode": { "type": "string" },
        "garduName": { "type": "string" },
        "feederName": { "type": "string" },
        "capacityKva": { "type": "number" },
        "phase": { "type": "string" },
        "garduType": { "type": "string" },
        "location": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "garduCode", "garduName", "feederName", "capacityKva", "status"]
    },
    "MasterPemutus": {
      "title": "MasterPemutus",
      "description": "Master data peralatan pemutus beban (Recloser, LBS, PMT, FCO)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "equipmentCode": { "type": "string" },
        "equipmentType": { "type": "string" },
        "feederName": { "type": "string" },
        "location": { "type": "string" },
        "brandModel": { "type": "string" },
        "currentRatingAmpere": { "type": "number" },
        "scadaStatus": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "equipmentCode", "equipmentType", "feederName", "status"]
    },
    "MaterialItem": {
      "title": "MaterialItem",
      "description": "Stok material pemeliharaan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "itemCode": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "stockQty": { "type": "number" },
        "unit": { "type": "string" },
        "minStock": { "type": "number" },
        "warehouseLocation": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "itemCode", "name", "stockQty"]
    },
    "ApdTool": {
      "title": "ApdTool",
      "description": "Daftar APD dan Alat Kerja K3",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "qty": { "type": "number" },
        "condition": { "type": "string" },
        "lastCalibrated": { "type": "string" },
        "unitOwner": { "type": "string" },
        "inspector": { "type": "string" }
      },
      "required": ["id", "code", "name", "qty"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "Kesiapan armada kendaraan Yantek",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "plateNumber": { "type": "string" },
        "name": { "type": "string" },
        "vehicleType": { "type": "string" },
        "status": { "type": "string" },
        "mileageKm": { "type": "number" },
        "teamAssigned": { "type": "string" },
        "fuelStatus": { "type": "string" }
      },
      "required": ["id", "plateNumber", "name", "status"]
    },
    "UserAccess": {
      "title": "UserAccess",
      "description": "Hak akses dan akun personel PLN",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nik": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "unitName": { "type": "string" },
        "email": { "type": "string" },
        "status": { "type": "string" },
        "lastActive": { "type": "string" }
      },
      "required": ["id", "nik", "name", "role", "email"]
    }
