rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Trips collection
    match /trips/{tripId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Feeder Health collection
    match /feeder_health/{healthId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // SAIDI / SAIFI collection
    match /saidi_saifi/{saidiId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // SPK Tasks collection
    match /spk_tasks/{spkId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Gardu Measurements collection
    match /gardu_measurements/{garduId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Master Feeders collection
    match /master_feeders/{feederId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Master Sections collection
    match /master_sections/{sectionId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Master Gardu Hubung collection
    match /master_gardu_hubung/{ghId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Master Gardu Distribusi collection
    match /master_gardu_distribusi/{gdId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Master Pemutus collection
    match /master_pemutus/{pmtId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Connection test collection
    match /_connection_test_/{testId} {
      allow read, write: if true;
    }

    // Materials collection
    match /materials/{materialId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // APD Tools collection
    match /apd_tools/{apdId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Vehicles collection
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Users Access collection
    match /users_access/{userId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // WhatsApp Messages collection
    match /whatsapp_messages/{messageId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
  }
}
